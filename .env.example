# ---- Base de datos (PostgreSQL) ----
DATABASE_URL=postgres://canchas:cambia-esta-clave@localhost:5432/canchas
# DATABASE_SSL=true            # actívalo si usas una BD en la nube (Supabase, Neon, Render, Azure...)

# ---- Servidor ----
PORT=3000
NODE_ENV=production
JWT_SECRET=pon-aqui-una-cadena-larga-y-aleatoria
APP_TZ=America/Bogota          # zona horaria del negocio (America/Mexico_City, America/Lima, America/Argentina/Buenos_Aires...)

# ---- Primer administrador (solo se usa si aún no existe ningún admin) ----
ADMIN_EMAIL=admin@tunegocio.com
ADMIN_PASSWORD=cambia-esta-clave

# ---- Reservas web ----
AUTO_CONFIRMAR_WEB=false       # true = las reservas web quedan confirmadas sin revisión
HORAS_MIN_CANCELACION=2        # anticipación mínima para que el cliente cancele en línea

# ---- Power BI / BI ----
BI_API_KEY=genera-una-clave-larga   # para el conector Web de Power BI (/api/bi/...)
BI_DB_PASSWORD=                      # si la pones, se crea el usuario de solo lectura "powerbi_reader"
